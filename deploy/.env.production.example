# ─────────────────────────────────────────────────────────────
# Endow Global — Production environment (self-hosted VPS)
# Copy to: apps/web/.env  (single source of truth for all processes)
# ─────────────────────────────────────────────────────────────

# ── Database (self-hosted MySQL on the VPS) ────────────────
DATABASE_URL="mysql://endow:YOUR_STRONG_DB_PASSWORD@127.0.0.1:3306/endow"
# Optional: pool tuning for KVM 4
# DB_POOL_SIZE=5
# DB_MAX_IDLE=5
# DB_SSL=false

# ── Better Auth ─────────────────────────────────────────────
BETTER_AUTH_URL="https://yourdomain.com"
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"   # openssl rand -base64 32

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_SOCKET_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="Endow Global Education"

# ── OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ── OpenAI / AI ─────────────────────────────────────────────
OPENAI_API_KEY=""

# ── Pinecone ────────────────────────────────────────────────
PINECONE_API_KEY=""
PINECONE_INDEX_NAME="endow-courses"
PINECONE_ENVIRONMENT=""

# ── Typesense (self-hosted via Docker on the VPS) ──────────
TYPESENSE_HOST="127.0.0.1"
TYPESENSE_PORT="8108"
TYPESENSE_API_KEY="YOUR_TYPESENSE_ADMIN_KEY"        # must match docker-compose --api-key
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY="YOUR_SEARCH_ONLY_KEY"

# ── Redis (Upstash REST — the app uses the REST API, not plain Redis) ──
# NOTE: the app (lib/redis.ts + login-rate-limit) talks to Upstash's REST API.
# A self-hosted Redis container is NOT compatible without refactoring.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── AWS S3 ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="endow-global-uploads"
AWS_ENDPOINT_URL_S3=""
NEXT_PUBLIC_CDN_URL=""

# ── Firebase ────────────────────────────────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ── SMTP ────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Endow Global <no-reply@yourdomain.com>"

# ── Cal.com ─────────────────────────────────────────────────
CAL_API_KEY=""
NEXT_PUBLIC_CAL_NAMESPACE="endow"

# ── UploadThing ─────────────────────────────────────────────
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# ── Socket Server ───────────────────────────────────────────
SOCKET_PORT="3001"
